# Cayworks Ad Engine — environment configuration
# Copy to .env and fill in real values.

# PostgreSQL connection string (Neon, Supabase, RDS, etc.). Required.
DATABASE_URL="postgresql://user:password@localhost:5432/cayworks_ad_engine?schema=public"

# Secret used to sign admin session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of this deployment (used in plugin snippets / README examples).
NEXT_PUBLIC_AD_ENGINE_URL="http://localhost:3000"

# Bootstrap superadmin (used by `npm run db:seed`).
SEED_SUPERADMIN_EMAIL="admin@cayworks.example"
SEED_SUPERADMIN_PASSWORD="ChangeMe123!"
