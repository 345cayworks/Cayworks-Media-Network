{
  "name": "cayworks-ad-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized advertising backend and reusable ad network plugin for Cayworks platforms.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postbuild": "tsx prisma/seed.ts || echo 'seed skipped (non-fatal)'",
    "db:migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "prisma generate && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "@vinext/cloudflare": "1.3.3",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "autoprefixer": "10.4.20",
    "cf": "1.0.0-beta.28",
    "postcss": "8.4.47",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module"
}
